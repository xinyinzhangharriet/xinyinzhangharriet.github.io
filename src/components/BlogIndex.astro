---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from './PostList.astro';
import { t } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);

const posts = (await getCollection('blog', (p) => p.id.startsWith(`${lang}/`) && !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.date.getFullYear();
  byYear.set(y, [...(byYear.get(y) ?? []), p]);
}
---
<Base lang={lang} title={tr('blog.title')} description={tr('blog.description')} altPath="/blog" current="/blog">
  <h1 class="page-title">{tr('blog.title')}</h1>
  <p class="page-desc">{tr('blog.description')}</p>
  {posts.length === 0 && <p>{tr('blog.empty')}</p>}
  {[...byYear.entries()].map(([year, list]) => (
    <section class="year-group">
      <h2>{year}</h2>
      <PostList posts={list} lang={lang} />
    </section>
  ))}
</Base>
